#PLATFORM = linux64

PLATFORM = linux64
CC       = gcc
CPP      = g++
CARGS    = -m64 -w 
CLIB     = 
RELEASE := $(shell uname -r | cut -f 1 -d .)
ifneq ($(RELEASE), 11)
	CPPSTDLIB = -std=c++17
endif
CPPLIB   =  $(CPPSTDLIB)
JSRC     = 
CLASSDIR = 
JFLAG    = -d . $(CLASSDIR)

#=== CLP ===
INC  = /usr/include/coin
CLP_LIB  = -lClp -lCoinUtils

all: exec_clp


exec_clp: ./exec.cc ./Simulator.cc ./Network_clp.cc ./Flow.cc ./Link.cc ./EventList.cc ./Stats.cc

	$(CPP) $(CARGS) -o ./BIN/exec_clp ./exec.cc ./Simulator.cc ./Network_clp.cc ./Flow.cc ./Link.cc ./EventList.cc ./Stats.cc -I$(INC) $(CPPLIB) $(CLP_LIB) -lpthread -lm

clean:
	rm -rf *.o *_c *_c++ *.class *.log *.rlp *.lp *.bas *.ilp *.dSYM
