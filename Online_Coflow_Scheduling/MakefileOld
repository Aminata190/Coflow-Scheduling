#PLATFORM = mac64
PLATFORM = macos_universal2
INC      = 
CC       = gcc
CPP      = g++
CARGS    = -m64 -w 
CLIB     = 
RELEASE := $(shell uname -r | cut -f 1 -d .)
ifneq ($(RELEASE), 11)
	CPPSTDLIB = -std=c++03
endif
CPPLIB   =  $(CPPSTDLIB)
JSRC     = 
CLASSDIR = 
JFLAG    = -d . $(CLASSDIR)

all: exec 

exec: ./exec.cc ./Simulator.cc ./Network.cc ./Flow.cc ./Link.cc ./EventList.cc ./Stats.cc

	$(CPP) $(CARGS) -o ./BIN/exec ./exec.cc ./Simulator.cc ./Network.cc ./Flow.cc ./Link.cc ./EventList.cc ./Stats.cc -I$(INC) $(CPPLIB) -lpthread -lm

clean:
	rm -rf *.o *_c *_c++ *.class *.log *.rlp *.lp *.bas *.ilp *.dSYM
